{
  "name": "threads-patrol-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply patrol-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply patrol-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node test/e2e/run.mjs",
    "demo": "node scripts/demo/stack.mjs",
    "demo:line": "node scripts/demo/line.mjs",
    "demo:seed": "node scripts/demo/seed.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
